# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceThis

# SQLite for local dev (default). For production, e.g. a Neon Postgres
# connection string (paste it in exactly as Neon's dashboard gives it,
# sslmode/channel_binding included — backend/app/database.py handles
# translating those for asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mafia
DATABASE_URL=sqlite+aiosqlite:///./mafia.db

# Any long random string — used to sign session tokens. Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-secret

SESSION_TTL_SECONDS=43200
CORS_ORIGINS=["https://your-frontend-domain.com"]
ENVIRONMENT=development

# Telegram user IDs allowed into the bot-owner admin panel (/admin/*
# endpoints, the "Admin" tab in the WebApp). Find your own numeric
# Telegram ID via @userinfobot. JSON array, can hold more than one.
ADMIN_TELEGRAM_IDS=[123456789]

# Webhook mode (app/telegram_bot.py): runs the bot's own logic (the join
# button) INSIDE this backend instead of bot/bot.py's separate polling
# process. Leave false for local dev and for a VPS/Fly.io deployment that
# uses bot/bot.py as-is — this is specifically for platforms with no free
# background-worker instance, like Render (see render.yaml at the repo
# root). A bot token can only be in webhook OR polling mode at a time.
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=change-me-to-another-long-random-secret
# Public URL this backend is reachable at. Leave blank on Render —
# RENDER_EXTERNAL_URL is injected automatically. Set explicitly for any
# other host when TELEGRAM_WEBHOOK_ENABLED=true.
WEBAPP_URL=

